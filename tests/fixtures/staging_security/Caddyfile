{
	admin off
}

:8080 {
	rate_limit {
		zone test_general {
			match {
				not path /media/*
			}
			key {remote_host}
			events 4
			window 2s
		}
		zone test_search {
			match {
				path /noticias/
				query buscar=*
			}
			key {remote_host}
			events 2
			window 2s
		}
		zone test_login {
			match {
				method POST
				path /admin/login/
			}
			key {remote_host}
			events 1
			window 2s
		}
	}

	respond "ok"

	log {
		output file /tmp/caddy-test/access.json {
			# Test-only readability for the unprivileged host harness. The real
			# staging Caddyfile is validated separately and requires 0640.
			mode 0644
			roll_size 1MiB
			roll_keep 1
			roll_keep_for 24h
		}
		format filter {
			request>uri query {
				replace buscar REDACTED
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			request>headers>Referer delete
		}
	}
}
